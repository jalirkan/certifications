__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db

# Study progress is personal data, not source. Keep the folder, ignore the log.
# Remove this line if you'd rather version your progress history.
*/results/attempts.jsonl

# Same rule for per-profile histories. Without this, a throwaway --profile used
# for testing lands in a commit, and so would a second learner's real history.
*/results/profiles/

# Every other result log, for the same reason. This list was previously just
# attempts.jsonl, which left games.jsonl, cases.jsonl and saved exam and case
# sessions exposed to a stray `git add .`. Personal study data, not source.
*/results/*.jsonl
*/results/exams/
*/results/cases/
*/results/settings.json

# Neural voice weights, ~107 MB, fetched by get_voices.py. Too big for a repo
# and reproducible from one command, so it is a setup step rather than source.
models/
